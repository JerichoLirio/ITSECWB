{{> navbar}}

<div class="profile-container">
    <!-- Profile Header Section -->
    <div class="profile-header">
        <div class="profile-picture-wrapper">
            <div class="profile-picture" id="profile-picture-container">
                {{#if currentUser.profilePicture}}
                    <img src="{{currentUser.profilePicture}}" alt="Profile Picture" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block;">
                {{else}}
                    <!-- Default User Avatar SVG -->
                    <img src="/images/person-circle.svg" alt="Default Avatar" style="width: 100%; height: 100%; display: block;">
                {{/if}}
            </div>
            {{#if isOwnProfile}}
            <div class="edit-icon" onclick="document.getElementById('profilePicInput').click();">
                <!-- Edit/Pencil Icon -->
                <img src="/images/edit-pencil.svg" alt="Edit Picture" style="width: 62.5%; height: 62.5%; display: block; opacity: 0.5;">
            </div>
            <input type="file" id="profilePicInput" style="display: none;" accept="image/*">
            {{/if}}

        </div>

        <div class="profile-divider"></div>

        <div class="d-flex flex-column flex-grow-1">
            <div class="profile-info">
                {{#if isOwnProfile}}
                    <button class="edit-bio-btn" data-bs-toggle="modal" data-bs-target="#editProfileModal">EDIT</button>
                {{/if}}

                <h1 class="profile-name">{{currentUser.username}}</h1>
                <p class="profile-bio">{{currentUser.description}}</p>
            </div>

            {{#if isOwnProfile}}
            <button id="deleteAccountBtn" class="btn bg-danger text-white mt-3 align-self-end">Delete Account</button>
            {{/if}}
        </div>
    </div>

    <!-- My Reservations Section -->
    <div class="reservations-section">
        <h2 class="reservations-title">My Reservations</h2>
        <div class="reservations-grid">
            {{#each reservations}}
            <!-- Reservation Card -->
            <div class="reservation-card">
                <img src="/images/office-space-1.jpg" alt="Office Space" class="reservation-image" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&h=600&fit=crop'">
                <div class="reservation-details">
                    <h3 class="reservation-name">{{this.labName}}</h3>
                    <p class="reservation-info">Seat: {{this.seat}}</p>
                    <p class="reservation-info">Date: {{this.date}}</p>
                    <p class="reservation-info">Time: {{this.time}}</p>
                </div>
            </div>
            {{else}}
            <p>No reservations yet.</p>
            {{/each}}
        </div>
        <button class="btn btn-secondary align-self-start mt-3" onclick="history.back();">Back</button>
    </div>

</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editProfileModalLabel">Edit Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editProfileForm">
          {{#if currentUser.profilePicture}}
          <div class="mb-3">
            <button type="button" class="btn btn-outline-danger btn-sm" id="removePicBtn">Remove profile picture</button>
          </div>
          {{/if}}
          <div class="mb-3">
            <label for="editEmail" class="form-label">Email address</label>
            <input type="email" class="form-control" id="editEmail" value="{{currentUser.email}}" required>
          </div>
          <div class="mb-3">
            <label for="editPassword" class="form-label">New Password</label>
            <input type="password" class="form-control" id="editPassword" placeholder="Leave blank to keep current password">
          </div>
          <div class="mb-3">
            <label for="editDescription" class="form-label">Bio / Description</label>
            <textarea class="form-control" id="editDescription" rows="3" placeholder="Description">{{currentUser.description}}</textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="saveProfileBtn">Save changes</button>
      </div>
    </div>
  </div>
</div>

{{#if isOwnProfile}}
<script>
let removeProfilePicture = false;

// Upload profile picture
document.getElementById('profilePicInput').addEventListener('change', async function() {
    if (!this.files[0]) return;
    const formData = new FormData();
    formData.append('profilePicture', this.files[0]);

    try {
        const res = await fetch('/api/account-profile/upload-picture', { method:'POST', body: formData });
        const result = await res.json();
        if (result.success) {
            document.getElementById('profile-picture-container').innerHTML = `<img src="${result.filePath}" alt="Profile Picture" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">`;
        } else alert(result.message || 'Failed to upload profile picture.');
    } catch(err){ console.error(err); alert('Upload error.'); }
});

// Remove picture
document.getElementById('removePicBtn')?.addEventListener('click', function() {
    if(confirm('Remove profile picture?')){
        removeProfilePicture = true;
        this.textContent = 'Picture will be removed on save';
        this.disabled = true;
    }
});

// Save profile
document.getElementById('saveProfileBtn').addEventListener('click', async function() {
    const email = document.getElementById('editEmail').value.trim();
    const password = document.getElementById('editPassword').value.trim();
    const description = document.getElementById('editDescription').value.trim();

    // Front-end validation
    if (!email) { alert('Email required'); return; }
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) { alert('Invalid email'); return; }
    if (password && password.length < MIN_PASSWORD_LENGTH) { 
        alert(`Password must be at least ${MIN_PASSWORD_LENGTH} characters`); 
        return; 
    }

    try {
        const bodyData = { email, description };
        if (password) bodyData.password = password;
        if (removeProfilePicture) bodyData.removeProfilePicture = true;

        const res = await fetch('/api/account-profile/update', { 
            method:'POST', 
            headers:{'Content-Type':'application/json'}, 
            body: JSON.stringify(bodyData) 
        });
        const result = await res.json();
        if(result.success){
            alert('Profile updated!');
            bootstrap.Modal.getInstance(document.getElementById('editProfileModal')).hide();
            window.location.reload();
        } else alert(result.message || 'Update failed.');
    } catch(err){ console.error(err); alert('Update error.'); }
});

// Delete account
document.getElementById('deleteAccountBtn')?.addEventListener('click', async function() {
    if(confirm('Delete your account?')){
        try {
            const res = await fetch('/api/account-profile/delete', { method:'DELETE' });
            const result = await res.json();
            if(result.success){ alert('Account deleted.'); window.location.href='/'; }
            else alert(result.message || 'Delete failed.');
        } catch(err){ console.error(err); alert('Delete error.'); }
    }
});
</script>
{{/if}}
