{{> navbar}}
{{> userModal}}
<div class="container py-4">
  <div class="card p-3 mb-4 shadow-sm">
    <h2>Administrator Dashboard</h2>
    <p class="text-muted mb-0">Admin-only area for account management and audit logs.</p>
  </div>

  <div class="card p-3 mb-4 shadow-sm">
    <h4>Create Account</h4>
    <div class="row g-2">
      <div class="col-md-2"><input class="form-control" id="new-username" placeholder="Username"></div>
      <div class="col-md-2"><input class="form-control" id="new-email" placeholder="Email"></div>
      <div class="col-md-2"><input type="password" class="form-control" id="new-password" placeholder="Password"></div>
      <div class="col-md-2"><input class="form-control" id="new-question" placeholder="Security question"></div>
      <div class="col-md-2"><input class="form-control" id="new-answer" placeholder="Recovery answer"></div>
      <div class="col-md-2">
        <select class="form-select" id="new-role">
          <option value="admin">Administrator</option>
          <option value="lab_manager">Lab Manager</option>
          <option value="student">Student</option>
        </select>
      </div>
    </div>
    <button class="btn btn-success mt-2 align-self-start" onclick="createPrivilegedUser()">Create Account</button>
  </div>

  <div class="card p-3 mb-4 shadow-sm">
    <h4>Users</h4>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Locked Until</th><th>Action</th></tr></thead>
        <tbody>
          {{#each users}}
          <tr>
            <td>{{this.username}}</td>
            <td>{{this.email}}</td>
            <td>{{roleName this.role}}</td>
            <td>{{formatDate this.lockUntil}}</td>
            <td>
              <button
                class="btn btn-sm btn-primary"
                onclick="openEditUser(this)"
                data-id="{{this._id}}"
                data-username="{{this.username}}"
                data-email="{{this.email}}"
                data-role="{{this.role}}"
              >Edit</button>
              {{#unless (eq this.username ../username)}}
                <button class="btn btn-sm btn-danger" onclick="deletePrivilegedUser('{{this._id}}')">Delete</button>
              {{/unless}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card p-3 shadow-sm">
    <h4>Recent Audit Logs</h4>
    <div class="row g-2 mb-2">
      <div class="col-md-3"><input class="form-control" id="filter-event" placeholder="Event type"></div>
      <div class="col-md-3">
        <select class="form-select" id="filter-status">
          <option value="">All statuses</option>
          <option value="success">Success</option>
          <option value="failure">Failure</option>
        </select>
      </div>
      <div class="col-md-2"><button class="btn btn-secondary" onclick="filterLogs()">Filter</button></div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm" id="logs-table">
        <thead><tr><th>Date</th><th>Event</th><th>Status</th><th>User</th><th>Role</th><th>Path</th></tr></thead>
        <tbody>
        {{#each logs}}
          <tr><td>{{formatDate this.createdAt}}</td><td>{{this.eventType}}</td><td>{{this.status}}</td><td>{{this.username}}</td><td>{{this.role}}</td><td>{{this.path}}</td></tr>
        {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit User modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editUserModalTitle">Edit Account</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="edit-user-id">
        <div class="mb-2">
          <label class="form-label" for="edit-username">Username</label>
          <input class="form-control" id="edit-username" placeholder="Username">
        </div>
        <div class="mb-2">
          <label class="form-label" for="edit-email">Email</label>
          <input class="form-control" id="edit-email" placeholder="Email">
        </div>
        <div class="mb-2">
          <label class="form-label" for="edit-password">Password</label>
          <input type="password" class="form-control" id="edit-password" placeholder="Leave blank to keep current password">
        </div>
        <div class="mb-2">
          <label class="form-label" for="edit-role">Role</label>
          <select class="form-select" id="edit-role">
            <option value="admin">Administrator</option>
            <option value="lab_manager">Lab Manager</option>
            <option value="student">Student</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" onclick="saveEditUser()">Save Changes</button>
      </div>
    </div>
  </div>
</div>
