<div class="register-box">
  <div class="corner-logo"><div class="logo-circle">LRS</div><div class="system-name">Lab Reservation System</div></div>
  <div class="register-title"><h1>Reset Password</h1></div>
  <form class="register-form" id="forgot-form">
    <div class="form-group"><div class="input-with-icon"><input type="text" id="reset-username" class="form-input" placeholder="Username" required></div></div>
    <button type="button" class="register-button" id="get-question-btn">Get Security Question</button>
    <p id="security-question-text" class="text-muted"></p>
    <div class="form-group"><div class="input-with-icon"><input type="text" id="security-answer" class="form-input" placeholder="Security Answer" required></div></div>
    <div class="form-group"><div class="input-with-icon"><input type="password" id="new-password" class="form-input" placeholder="New Password" required></div></div>
    <button type="submit" class="register-button">Reset Password</button>
  </form>
  <div class="login-link"><a href="/login">Back to login</a></div>
</div>
