<div class="main-container">
    {{!-- Branding section --}}
    <div class="top-bar">
        <a href="/home" class="corner-logo" style="text-decoration:none; color:inherit;">
            <div class="logo-circle">LRS</div>
            <div class="system-name">Lab Reservation System</div>
        </a>
        <div class="user-corner">
            <button id="userBtn" class="btn user-btn" data-bs-toggle="modal" data-bs-target="#userModal">
                <img id="userIcon" src="/images/person-circle.svg" style="width:40px;">              
            </button>
        </div>
    </div>

    {{!-- Hero Section --}}
    <div class="hero-section">
        <div class="hero-image-placeholder">
            <div class="search-box">
                <input 
                    type="text" 
                    placeholder="Search labs" 
                    id="lab-search" 
                    class="search-input"
                    autocomplete="off"
                >
                <img src="/images/magnifying.svg" alt="Search" class="search-icon">

                {{!-- Suggestions Dropdown - Populated by homepage.js --}}
                <div id="search-suggestions" class="search-suggestions"></div>
            </div>
        </div>
    </div>

    {{!-- Content Section --}}
    <div class="content-section">
        <h2 class="section-title">Popular Labs</h2>
        <hr class="section-divider">
 
        <div class="lab-grid">
            <a href="/reservation/G404A">
                <div class="lab-card">
                    <div class="lab-image-container" style="background-image: url('/images/Goks.jpg');">
                        <span class="lab-label">G404A</span>
                    </div>
                </div>
            </a>

            <a href="/reservation/G404B">
                <div class="lab-card">
                    <div class="lab-image-container" style="background-image: url('/images/Goks.jpg');">
                        <span class="lab-label">G404B</span>
                    </div>
                </div>
            </a>

            <a href="/reservation/V101">
                <div class="lab-card">
                    <div class="lab-image-container" style="background-image: url('/images/Velasco.jpg');">
                        <span class="lab-label">V101</span>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

{{> userModal}}
