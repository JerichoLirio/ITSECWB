<!-- Register Box -->
<div class="register-box">

    <!-- Header -->
    <div class="corner-logo">
        <div class="logo-circle">LRS</div>
        <div class="system-name">Lab Reservation System</div>
    </div>

    <div class="register-title">
        <h1>Register</h1>
    </div>

    <form class="register-form" id="register-form">

        <!-- Username Field -->
        <div class="form-group">
            <div class="input-with-icon">
                <div class="input-icon">
                    <img src="/images/user.svg" alt="User icon" class="svg-icon">
                </div>
                <input 
                    type="text" 
                    id="username" 
                    name="username"
                    class="form-input" 
                    placeholder="Choose a Username"
                    required
                >
            </div>
        </div>

        <div class="form-group">
            <div class="input-with-icon">
                <div class="input-icon">
                <img src="/images/user.svg" alt="Email icon" class="svg-icon">
                </div>
                <input type="email" id="email" name="email" class="form-input" placeholder="Enter your email" required>
            </div>
        </div>

        <!-- Password Field -->
        <div class="form-group">
            <div class="input-with-icon">
                <div class="input-icon">
                    <img src="/images/password.svg" alt="Password icon" class="svg-icon">
                </div>
                <input 
                    type="password" 
                    id="password" 
                    name="password"
                    class="form-input" 
                    placeholder="Create Password"
                    required
                >
            </div>
        </div>

        <!-- Confirm Password Field -->
        <div class="form-group">
            <div class="input-with-icon">
                <div class="input-icon">
                    <img src="/images/password.svg" alt="Password icon" class="svg-icon">
                </div>
                <input 
                    type="password" 
                    id="confirm-password" 
                    name="confirmPassword"
                    class="form-input" 
                    placeholder="Confirm Password"
                    required
                >
            </div>
        </div>


        <div class="form-group">
            <div class="input-with-icon">
                <input type="text" id="security-question" name="securityQuestion" class="form-input" placeholder="Create your own security question" required>
            </div>
        </div>

        <div class="form-group">
            <div class="input-with-icon">
                <input type="text" id="security-answer" name="securityAnswer" class="form-input" placeholder="Security answer (use a specific/random answer)" required>
            </div>
        </div>
        <!-- Button Container -->
        <button type="submit" class="register-button">
            Create Account
        </button>
    </form>

    <!-- Login Link -->
    <div class="login-link">
        <span style="color: #666;">Already have an account? </span>
        <a href="/login">Sign in here</a>
    </div>

</div>

